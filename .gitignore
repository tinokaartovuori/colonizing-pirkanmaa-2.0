node_modules/
dist/
*.log
.DS_Store
.vite/
.playwright-mcp/

# Rust trainer build artifacts (target, target-mcts, any target*)
rust-trainer/target*

# NOTE: training checkpoints (rust-trainer/checkpoints-*/) and cnn-backups/ ARE
# committed intentionally (~32MB total) so the full training history + trained nets
# travel to other devices. Only the regenerable build target/ is excluded here.

# Model weights blobs are large; the registry + manifests (metadata) ARE tracked.
# Uncomment to stop tracking the weight blobs themselves:
# models/**/weights.json

# Local backend SQLite database (regenerable, not source)
server/data/

# Cloudflare Worker local state (wrangler login token cache, dev DB, deps)
worker/.wrangler/
worker/node_modules/

# Claude Code local runtime state (session locks etc.) — never commit
.claude/scheduled_tasks.lock
.claude/*.lock
