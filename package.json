{
  "name": "colonizing-pirkanmaa",
  "version": "1.0.0",
  "description": "Colonizing Pirkanmaa — TypeScript + Phaser 3 port of the TUNI Programming 3 strategy game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "models": "vite-node models/manage.ts",
    "server": "node --experimental-sqlite server/server.js"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  }
}
